# Copy this file to `.env` and fill in real values.

# Port the API listens on
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shopsphere

# Secret used to sign JWTs — use a long random string
JWT_SECRET=replace_with_a_long_random_secret

# Stripe keys (test mode)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Frontend origin, used for CORS and Stripe redirect URLs.
# Comma-separate multiple origins.
CLIENT_URL=http://localhost:5173

# Optional: credentials for the admin account created by `npm run seed`.
# Always set a strong password before seeding a public deployment.
SEED_ADMIN_EMAIL=admin@shopsphere.dev
SEED_ADMIN_PASSWORD=change_me_please
